# Set these as Variables in Railway. Never commit real values.

# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole JSON file contents as one value.
FIREBASE_SERVICE_ACCOUNT=

# Right-click in Discord with Developer Mode on -> Copy ID
GUILD_ID=
STAFF_ROLE_ID=
CUSTOMER_ROLE_ID=
TICKET_CATEGORY_ID=
LOG_CHANNEL_ID=

# Optional: shown at the top of every purchase ticket
PAYMENT_INFO=
SITE_URL=https://sovyx.cc

# Loader downloads (customer pages). Attach a Railway volume mounted at /data so uploads survive redeploys.
DATA_DIR=/data
# Sites allowed to call the API from a browser
ALLOWED_ORIGINS=https://sovyx.cc
